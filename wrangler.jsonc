// Cloudflare Worker with static assets. GitHub Actions (.github/workflows/deploy.yml) runs `wrangler deploy` on every
// push to main, which first runs the build below (src/ + public/ -> dist/) and then uploads dist/ plus worker/index.js
// (the small /api relay for the Earnings lookup).
{
  "name": "firedbunny",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "python3 tools/build.py" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // /audio/* goes through the Worker so recordings answer byte-range requests (needed by iPhone and iPad)
    "run_worker_first": ["/api/*", "/audio/*"]
  },
  // SEC asks automated tools to identify themselves with a contact email. Set SEC_UA (e.g. "FiredBunny you@example.com")
  // in the Cloudflare dashboard (Worker > Settings > Variables and Secrets); keep_vars stops deploys from erasing it.
  "keep_vars": true
}
