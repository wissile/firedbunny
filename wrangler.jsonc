// Cloudflare Worker with static assets. Workers Builds runs `npx wrangler deploy`, which first runs the build below
// (src/ + public/ -> dist/) and then uploads dist/ plus worker/index.js (the small /api relay for the Earnings lookup).
{
  "name": "firedbunny",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "python3 tools/build.py" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // SEC asks automated tools to identify themselves with a contact email. Set SEC_UA (e.g. "FiredBunny you@example.com")
  // in the Cloudflare dashboard (Worker > Settings > Variables and Secrets); keep_vars stops deploys from erasing it.
  "keep_vars": true
}
